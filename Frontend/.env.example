# API Configuration
# Use /api to go through Vite proxy (recommended for development)
# The proxy is configured in vite.config.ts to forward to http://localhost:3000
VITE_API_BASE_URL=/api

# Session Configuration
VITE_SESSION_TIMEOUT_MS=900000

# Feature Flags
VITE_ENABLE_VOICE_RECORDING=false
VITE_ENABLE_OFFLINE_MODE=false

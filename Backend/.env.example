# Home Health Care AI Assistant - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - Application will not start without these
# =============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/homehealthai?schema=public"

# JWT Secrets (minimum 32 characters each)
JWT_ACCESS_SECRET="your-access-secret-minimum-32-characters-long"
JWT_REFRESH_SECRET="your-refresh-secret-minimum-32-characters-long"

# Encryption Key for EMR tokens (minimum 32 characters)
EMR_ENCRYPTION_KEY="your-emr-encryption-key-minimum-32-chars"

# =============================================================================
# REQUIRED IN PRODUCTION
# =============================================================================

# Data Encryption (minimum 32 characters for key, 16 for salt)
ENCRYPTION_KEY="your-encryption-key-minimum-32-characters"
ENCRYPTION_SALT="your-salt-min-16ch"

# CORS - comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS="https://yourdomain.com,https://app.yourdomain.com"

# =============================================================================
# AI SERVICES
# =============================================================================

# OpenAI (for Whisper transcription)
OPENAI_API_KEY="sk-..."

# Anthropic (for Claude AI extraction and generation)
ANTHROPIC_API_KEY="sk-ant-..."

# =============================================================================
# COMMUNICATION SERVICES
# =============================================================================

# SendGrid (for email)
SENDGRID_API_KEY="SG...."
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
SENDGRID_FROM_NAME="Home Health Care"

# Twilio (for fax)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_FAX_NUMBER="+1234567890"

# =============================================================================
# EMR INTEGRATION
# =============================================================================

# Epic FHIR
EPIC_CLIENT_ID=""
EPIC_FHIR_BASE_URL=""

# Cerner FHIR
CERNER_CLIENT_ID=""
CERNER_FHIR_BASE_URL=""

# PointCare (add when available)
POINTCARE_API_KEY=""
POINTCARE_BASE_URL=""

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# Session
SESSION_TIMEOUT_MINUTES=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# =============================================================================
# OPTIONAL - Development helpers
# =============================================================================

# Enable mock services (set to 'true' in development)
USE_MOCK_FHIR=true
USE_MOCK_EMAIL=true
USE_MOCK_FAX=true

# ---------------------------------------------------------------------------
# Row-level security
#
# DATABASE_URL above is the owner connection: used by migrations only.
#
# The running application must connect as a NON-SUPERUSER role, or Postgres
# bypasses every tenant policy and isolation silently does nothing. Create the
# role once per environment:
#
#   APP_DB_PASSWORD=... psql "$DATABASE_URL" -f scripts/setup-app-role.sql
#
# Then point the app at it. Queries must run inside withTenant() — outside one,
# the policies return zero rows by design.
APP_DATABASE_URL="postgresql://hha_app:change-me@localhost:5432/homehealthai"

# ============================================
# Home Health Care AI Assistant - Backend
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================

# --------------------------------------------
# APPLICATION
# --------------------------------------------
NODE_ENV=development
PORT=3000
API_VERSION=v1

# --------------------------------------------
# DATABASE CONNECTION
# PostgreSQL connection settings
# --------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=home_health_care_db
DB_USER=your_database_user
DB_PASSWORD=your_secure_database_password

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# SSL mode for production (disable, require, verify-ca, verify-full)
DB_SSL_MODE=disable

# Full connection string (alternative to individual settings)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# --------------------------------------------
# AUTHENTICATION & SECURITY
# JWT configuration for secure token handling
# --------------------------------------------
# Secret key for signing access tokens (min 32 characters, use cryptographically random string)
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars

# Secret key for signing refresh tokens (different from access secret)
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars

# Token expiration times
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Password hashing rounds (higher = more secure but slower)
BCRYPT_SALT_ROUNDS=12

# Session secret for cookie signing
SESSION_SECRET=your_session_secret_min_32_chars

# --------------------------------------------
# VOICE-TO-TEXT SERVICES
# API credentials for speech recognition
# --------------------------------------------
# Google Cloud Speech-to-Text
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_CLOUD_SPEECH_API_KEY=your_google_speech_api_key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# AWS Transcribe (alternative)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_TRANSCRIBE_LANGUAGE_CODE=en-US

# OpenAI Whisper API (alternative)
OPENAI_API_KEY=your_openai_api_key

# Default voice-to-text provider (google, aws, openai)
VOICE_TO_TEXT_PROVIDER=google

# --------------------------------------------
# EMR INTEGRATION
# Electronic Medical Records system credentials
# --------------------------------------------
# FHIR Server Configuration
FHIR_BASE_URL=https://your-emr-fhir-server.com/fhir
FHIR_API_VERSION=R4

# OAuth2 credentials for EMR authentication
EMR_CLIENT_ID=your_emr_client_id
EMR_CLIENT_SECRET=your_emr_client_secret
EMR_TOKEN_URL=https://your-emr-auth-server.com/oauth2/token
EMR_SCOPE=patient/*.read patient/*.write

# Epic MyChart Integration (if applicable)
EPIC_CLIENT_ID=your_epic_client_id
EPIC_PRIVATE_KEY_PATH=/path/to/epic-private-key.pem

# Cerner Integration (if applicable)
CERNER_CLIENT_ID=your_cerner_client_id
CERNER_CLIENT_SECRET=your_cerner_client_secret

# HL7 Interface settings
HL7_INBOUND_PORT=2575
HL7_OUTBOUND_HOST=your_hl7_receiver_host
HL7_OUTBOUND_PORT=2576

# --------------------------------------------
# FILE UPLOAD & STORAGE
# Configuration for patient document storage
# --------------------------------------------
# Storage provider (local, s3, azure, gcs)
STORAGE_PROVIDER=s3

# Local storage path (for development)
LOCAL_UPLOAD_PATH=./uploads
LOCAL_UPLOAD_MAX_SIZE_MB=50

# AWS S3 Configuration
S3_BUCKET_NAME=your-hipaa-compliant-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key

# S3 encryption settings (required for HIPAA)
S3_ENCRYPTION=AES256
S3_KMS_KEY_ID=your_kms_key_id

# Azure Blob Storage (alternative)
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_ACCESS_KEY=your_azure_access_key
AZURE_STORAGE_CONTAINER=patient-documents

# Google Cloud Storage (alternative)
GCS_BUCKET_NAME=your-gcs-bucket
GCS_PROJECT_ID=your_gcp_project_id

# File upload limits
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx,dicom

# --------------------------------------------
# CORS CONFIGURATION
# Allowed origins for cross-origin requests
# --------------------------------------------
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Allow credentials (cookies, authorization headers)
CORS_ALLOW_CREDENTIALS=true

# Allowed HTTP methods
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Allowed headers
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# --------------------------------------------
# RATE LIMITING
# Protect against abuse and DDoS
# --------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Stricter limits for auth endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# --------------------------------------------
# LOGGING & MONITORING
# --------------------------------------------
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log format (json, simple)
LOG_FORMAT=json

# External logging service (optional)
LOGGLY_TOKEN=your_loggly_token
DATADOG_API_KEY=your_datadog_api_key

# --------------------------------------------
# HIPAA AUDIT LOGGING
# Required for compliance
# --------------------------------------------
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2190

# External audit log service
AUDIT_LOG_ENDPOINT=https://your-audit-service.com/logs

# --------------------------------------------
# EMAIL SERVICE
# For notifications and alerts
# --------------------------------------------
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_ADDRESS=noreply@yourdomain.com

# SendGrid (alternative)
SENDGRID_API_KEY=your_sendgrid_api_key

# --------------------------------------------
# AI/ML SERVICES
# For health care AI assistant features
# --------------------------------------------
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Azure OpenAI (alternative for HIPAA compliance)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# --------------------------------------------
# ENCRYPTION
# Data encryption at rest
# --------------------------------------------
# Master encryption key (32 bytes, base64 encoded)
ENCRYPTION_MASTER_KEY=your_base64_encoded_32_byte_key

# Key rotation interval (days)
KEY_ROTATION_INTERVAL_DAYS=90
